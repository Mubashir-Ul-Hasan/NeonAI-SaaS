# =========================
# App URLs
# =========================
APP_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
VITE_APP_URL=http://localhost:5173

# When using http://localhost:8888 as the app URL, leave this empty.
# When using Vite directly at http://localhost:5173, set:
# VITE_API_BASE_URL=http://localhost:8888
VITE_API_BASE_URL=

# =========================
# Clerk Auth
# =========================
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret

# Optional Clerk Billing URLs
CLERK_BILLING_CHECKOUT_URL=
CLERK_BILLING_PORTAL_URL=

# Admin access
ADMIN_USER_IDS=
ADMIN_EMAILS=admin@example.com

# =========================
# Neon Database
# =========================
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# =========================
# Gemini AI
# =========================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# =========================
# Clipdrop
# =========================
CLIPDROP_API_KEY=

# =========================
# Cloudinary
# =========================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# =========================
# Usage Limits
# =========================
MAX_UPLOAD_SIZE_MB=10
FREE_MONTHLY_LIMIT=20
PREMIUM_MONTHLY_LIMIT=500